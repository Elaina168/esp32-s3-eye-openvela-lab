+int esp32s3_spi_send_rgb565_rows(struct spi_dev_s *dev,
+                                 const uint8_t *pixels, size_t row_bytes,
+                                 size_t stride, size_t rows)
+{
+  struct esp32s3_spi_priv_s *priv = (struct esp32s3_spi_priv_s *)dev;
+  size_t used = 0;
+  int ret;
+
+  DEBUGASSERT(priv->nbits == 16 && row_bytes % 2 == 0 &&
+              stride >= row_bytes);
+
+  for (size_t row = 0; row < rows; row++)
+    {
+      const uint8_t *src = pixels + row * stride;
+      size_t remaining = row_bytes;
+
+      while (remaining != 0)
+        {
+          size_t bytes = MIN(remaining, SPI_DMA_TX16_BYTES - used);
+          uint8_t *dst = priv->tx16_wire + used;
+
+          /* 取有效像素时完成线上字节序转换，跳过行尾间隔。 */
+
+          for (size_t i = 0; i < bytes; i += 2)
+            {
+              dst[i] = src[i + 1];
+              dst[i + 1] = src[i];
+            }
+
+          remaining -= bytes;
+          src += bytes;
+          used += bytes;
+          if (used == SPI_DMA_TX16_BYTES)
+            {
+              ret = esp32s3_spi_dma_exchange(priv, priv->tx16_wire,
+                                             NULL, used / 2);
+              if (ret < 0)
+                {
+                  return ret;
+                }
+
+              used = 0;
+            }
+        }
+    }
+
+  if (used != 0)
+    {
+      return esp32s3_spi_dma_exchange(priv, priv->tx16_wire,
+                                      NULL, used / 2);
+    }
+
+  return OK;
 }
+
 #endif
 
